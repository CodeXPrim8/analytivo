{
  "framework": "nextjs",
  "regions": ["dub1"],
  "installCommand": "npm install",
  "buildCommand": "npx prisma generate && npx prisma migrate deploy && next build",
  "crons": [
    {
      "path": "/api/cron/reports",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/billing",
      "schedule": "30 2 * * *"
    }
  ]
}
