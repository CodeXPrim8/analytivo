# Local / production database (Supabase)
# Use the "Transaction" pooler URI (port 6543) for the app:
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the "Session" or direct URI (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
# Preferred / primary public URL (any of your domains is fine):
BETTER_AUTH_URL="https://analytivo.net"
NEXT_PUBLIC_APP_URL="https://analytivo.net"
# Extra domains are already trusted in code; override/extend with:
# AUTH_ALLOWED_HOSTS="analytivo.net,analytivo.xyz,analytivo.com.ng,analytivo.top"
# AUTH_TRUSTED_ORIGINS="https://analytivo.net,https://analytivo.xyz,https://analytivo.com.ng,https://analytivo.top"

# Optional Supabase API keys (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# AI Insights (optional — falls back to smart rules without this)
OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# Team invite emails and scheduled reports (optional — invite links can be
# copied manually and reports can be exported without this)
# Get a key at resend.com, then verify your sending domain.
RESEND_API_KEY="re_..."
EMAIL_FROM="Analytivo <invites@analytivo.net>"
# Inbox for the website contact form (footer envelope icon)
CONTACT_EMAIL="brandcrea8digital@yahoo.com"

# Protects /api/cron/reports and /api/cron/billing so only Vercel Cron can run
# them. Any long random string; set the same value in the Vercel project settings.
CRON_SECRET="replace-with-a-long-random-secret"

# Card payments (optional — the app runs on the Free plan without these).
# Paystack Dashboard → Settings → API Keys & Webhooks. Use sk_test_... until live.
# The same secret key both authorises API calls and signs incoming webhooks.
PAYSTACK_SECRET_KEY="sk_test_..."
# Create one Paystack plan per paid tier (Dashboard → Plans), then paste the
# plan codes here. The amount and currency set there is what customers are
# actually charged — this repo never sets a price.
PAYSTACK_PLAN_CODE_PRO="PLN_..."
PAYSTACK_PLAN_CODE_BUSINESS="PLN_..."

# OPay Checkout (optional second gateway). Merchant dashboard → API Keys & Webhooks.
# Webhook URL: https://YOUR_DOMAIN/api/webhooks/opay
OPAY_MERCHANT_ID=""
OPAY_PUBLIC_KEY=""
OPAY_SECRET_KEY=""
# Sandbox until you are ready for real charges. Then set OPAY_LIVE=true and
# switch to Live keys from the OPay dashboard.
# OPAY_LIVE="true"
OPAY_BASE_URL="https://testapi.opaycheckout.com/api/v1/international"
# Prepaid window. Omit this (and set OPAY_LIVE=true) for a real calendar month.
OPAY_PERIOD_MINUTES="5"