# Local / production database (Supabase)
# Use the "Transaction" pooler URI (port 6543) for the app:
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Use the "Session" or direct URI (port 5432) for migrations:
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Optional: custom domain hosts/origins (comma-separated)
# AUTH_ALLOWED_HOSTS="analytivo.com,www.analytivo.com"
# AUTH_TRUSTED_ORIGINS="https://analytivo.com,https://www.analytivo.com"

# Optional Supabase API keys (Dashboard → Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_JWKS_URL="https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json"

# AI Insights (optional — falls back to smart rules without this)
OPENAI_API_KEY="sk-..."
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"
