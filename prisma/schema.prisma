generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id
  name          String
  email         String         @unique
  emailVerified Boolean        @default(false)
  image         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  workspaceName String         @default("My Workspace")
  /// Effective entitlement. Only the Paystack webhook and the billing sweep may
  /// raise this above "free" — never a user action.
  plan          String         @default("free")

  /// Which gateway owns the current paid period: paystack | opay | null.
  billingProvider      String?
  /// Paystack customer code, kept so repeat checkouts reuse one customer.
  paystackCustomerCode String?
  /// Paystack subscription code; null while on free.
  subscriptionCode     String? @unique
  /// Paystack email token, required alongside the code to cancel.
  subscriptionToken    String?
  /// Last OPay merchant reference that granted (or extended) access.
  opayReference        String? @unique
  /// OPay order number for the latest successful cashier payment.
  opayOrderNo          String?
  /// none | active | past_due | canceled
  subscriptionStatus   String  @default("none")
  /// Plan the subscription pays for, which can outlive a downgrade request.
  subscriptionPlan     String?
  /// Paid access lasts until this instant even after a failed renewal.
  currentPeriodEnd     DateTime?
  /// Set when the subscription is stopped but the paid period has not elapsed.
  cancelAtPeriodEnd    Boolean @default(false)

  sessions      Session[]
  accounts      Account[]
  campaigns     Campaign[]
  links         Link[]
  qrCodes       QRCode[]
  reports       Report[]
  teamMembers   TeamMember[]   @relation("WorkspaceMembers")
  memberships   TeamMember[]   @relation("MemberAccount")
  insights      Insight[]
  notifications Notification[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  body      String
  type      String   @default("insight")
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Campaign {
  id          String    @id @default(cuid())
  name        String
  description String?
  status      String    @default("active")
  startDate   DateTime  @default(now())
  endDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  links       Link[]

  @@index([userId])
}

model Link {
  id          String    @id @default(cuid())
  title       String
  alias       String    @unique
  originalUrl String
  source      String    @default("direct")
  utmSource   String?
  utmMedium   String?
  utmCampaign String?
  expiresAt   DateTime?
  password    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaignId  String?
  campaign    Campaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  clicks      Click[]
  qrCodes     QRCode[]

  @@index([userId])
  @@index([campaignId])
}

model Click {
  id          String   @id @default(cuid())
  linkId      String
  link        Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  visitorId   String
  referrer    String?
  source      String?
  device      String?
  browser     String?
  os          String?
  country     String?
  city        String?
  language    String?
  isReturning Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([linkId])
  @@index([visitorId])
  @@index([createdAt])
}

model QRCode {
  id         String   @id @default(cuid())
  linkId     String
  link       Link     @relation(fields: [linkId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  frameColor String   @default("#7c3aed")
  shape      String   @default("square")
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([linkId])
}

/// A saved reporting view. `rangeDays` is a rolling window so scheduled
/// deliveries always cover the period leading up to the send.
model Report {
  id          String    @id @default(cuid())
  name        String
  description String?
  type        String    @default("performance")
  rangeDays   Int       @default(30)
  /// Comma-separated link ids the report covers. Empty means every link in the
  /// workspace, which is also what reports created before scoping existed mean.
  linkIds     String    @default("")
  recipients  String    @default("")
  schedule    String?
  lastSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([schedule])
}

/// A person invited to the workspace owned by `userId`.
/// Becomes usable access only once `status` is "active" and `memberUserId` is linked.
model TeamMember {
  id           String    @id @default(cuid())
  name         String
  email        String
  role         String    @default("viewer")
  avatar       String?
  status       String    @default("pending")
  inviteToken  String?   @unique
  invitedAt    DateTime  @default(now())
  acceptedAt   DateTime?
  joinedAt     DateTime  @default(now())
  userId       String
  user         User      @relation("WorkspaceMembers", fields: [userId], references: [id], onDelete: Cascade)
  memberUserId String?
  memberUser   User?     @relation("MemberAccount", fields: [memberUserId], references: [id], onDelete: SetNull)

  @@unique([userId, email])
  @@index([userId])
  @@index([memberUserId, status])
}

model Insight {
  id          String   @id @default(cuid())
  title       String
  description String
  confidence  Float    @default(0.7)
  actionItems String
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Payment providers retry deliveries, so every handled payload is recorded by
/// a hash of its body and replays are dropped rather than applied twice.
model ProcessedWebhook {
  id         String   @id
  provider   String   @default("paystack")
  event      String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}
